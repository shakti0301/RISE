@model List<EmployeeApplication.Models.Employee>

<h2>Employee List</h2>

<a href="/Employee/Create">Add Employee</a>

<table border="1">
<tr>
    <th>Id</th>
    <th>Name</th>
    <th>Salary</th>
    <th>Action</th>
</tr>

@foreach (var emp in Model)
{
<tr>
    <td>@emp.Id</td>
    <td>@emp.Name</td>
    <td>@emp.Salary</td>
    <td>
        <a href="/Employee/Edit/@emp.Id">Edit</a> |
        <a href="/Employee/Delete/@emp.Id">Delete</a>
    </td>
</tr>
}
</table>